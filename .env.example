DISCORD_TOKEN=token_do_bot
CLIENT_ID=id_da_aplicacao
GUILD_ID=id_do_servidor

# Opcionais: cargos de equipe para a primeira configuração.
ADMIN_ROLE_ID=
SELLER_ROLE_ID=

# Após a primeira configuração, preserve aqui o ID do canal privado de dados.
# Permite localizar o histórico mesmo se o canal for renomeado.
DISCORD_DATA_CHANNEL_ID=

# Chave AES-256: 32 bytes em base64. Gere uma vez com npm run keygen.
# Preserve uma cópia segura fora do servidor. Não troque ao reiniciar.
ENCRYPTION_KEY=
